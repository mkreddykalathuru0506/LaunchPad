# One-shot container that runs Prisma migrations and the admin seed,
# then exits. Pulled in by `docker compose --profile tools run --rm migrate`.

FROM node:20-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl ca-certificates python3 build-essential \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci --no-audit --no-fund

# Generate the client + the seed runner needs tsx
RUN npx prisma generate

# Default command: apply versioned migrations then seed.
# Falls back to `db push --accept-data-loss` for the legacy db-push setup —
# this stays idempotent because migrate deploy is the authoritative path
# (the prisma/migrations folder now has migration_lock.toml + the
# case_portal_candidate_link migration). --accept-data-loss is harmless for
# adding nullable columns + unique indexes; the existing data is preserved.
CMD sh -lc "(npx prisma migrate deploy || npx prisma db push --skip-generate --accept-data-loss) && npx tsx prisma/seed.ts"
