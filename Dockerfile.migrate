# One-shot container that runs Prisma migrations and the admin seed,
# then exits. Pulled in by `docker compose --profile tools run --rm migrate`.

FROM node:20-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl ca-certificates python3 build-essential postgresql-client \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json tsconfig.json ./
COPY prisma ./prisma
# seed.ts imports the shared stage-selection helper from src/lib, so the seed
# needs src on disk (tsx resolves ../src/lib/stages at runtime).
COPY src ./src
RUN npm ci --no-audit --no-fund

# Generate the client + the seed runner needs tsx
RUN npx prisma generate

# Idempotent migrate+seed wrapper. Handles three cases:
#   - fresh DB                  -> migrate deploy applies everything
#   - legacy db-push prod DB    -> baseline via `migrate resolve --applied`
#                                  then migrate deploy is a no-op
#   - already-baselined DB      -> migrate deploy applies any new migrations
# See scripts/migrate-and-seed.sh for details. Re-runs are safe / no-ops.
COPY scripts/migrate-and-seed.sh /usr/local/bin/migrate-and-seed.sh
RUN chmod +x /usr/local/bin/migrate-and-seed.sh

CMD ["/usr/local/bin/migrate-and-seed.sh"]
