# ─────────────────────────── Database ───────────────────────────
DATABASE_URL="postgresql://launchpad:launchpad@localhost:5432/launchpad?schema=public"
# Used by docker-compose to seed Postgres on first boot (production)
POSTGRES_USER="launchpad"
POSTGRES_PASSWORD="launchpad"
POSTGRES_DB="launchpad"

# ────────────────────────────── Auth ────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-openssl-rand-base64-32"

# ───────────────────────── Crypto (PII at rest) ─────────────────
# AES-256-GCM column encryption for SSN / Aadhaar / DOB / service number.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="replace-me-32-byte-base64-key"

# ─────────────────────────── Mailer ─────────────────────────────
# Options: console | filesystem | resend | smtp
MAILER_DRIVER="filesystem"
MAILER_FROM="Launch Pad <no-reply@launchpad.local>"

# Resend (recommended for production)
RESEND_API_KEY=""

# SMTP (alternative — Hostinger, AWS SES, etc.)
# Hostinger settings:
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465      SMTP_SECURE=true     (implicit TLS — recommended)
#   SMTP_PORT=587      SMTP_SECURE=false    (STARTTLS)
# SMTP_USER must equal the From address used by MAILER_FROM, or Hostinger rejects.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# ─────────────────────────── Storage ────────────────────────────
# Options: local | s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./uploads"
# Override in production to "/data/uploads" (matches the Docker volume mount)

# S3 (optional, when STORAGE_DRIVER=s3)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ─────────── Verification adapters (mock | onfido | persona | checkr | authbridge) ───────────
ADAPTER_IDENTITY="mock"
ADAPTER_ADDRESS="mock"
ADAPTER_EDUCATION="mock"
ADAPTER_EMPLOYMENT="mock"
ADAPTER_CRIMINAL="mock"
ADAPTER_PHOTO="mock"
ADAPTER_VIDEO="mock"
ADAPTER_REFERENCE="mock"

# ──────────────────────────── App ───────────────────────────────
APP_NAME="Launch Pad"
APP_BRAND_COLOR="#6366f1"
APP_SUPPORT_EMAIL="bgv@elivixit.com"
APP_URL="http://localhost:3000"
LOG_LEVEL="info"

# ─────────────────── Production-only ────────────────────────────
# Domain that Caddy will request a TLS cert for. Read by Caddyfile.
LAUNCHPAD_DOMAIN="launchpad.local"

# First-run admin (created by `prisma seed`, idempotent)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="ChangeMe-Strong-Passw0rd!"
ADMIN_NAME="Launch Pad Admin"

# When set to "true", seed demo users + cases. Always "false" in production.
SEED_DEMO="true"

# ───────── Company-portal BGV integration ─────────
# Shared HMAC secret. Must match the portal's BGV_WEBHOOK_SECRET. Generate with:
#   openssl rand -hex 32
PORTAL_WEBHOOK_SECRET=""
# Portal endpoint that receives bgv.cleared / bgv.rejected / bgv.withdrawn.
PORTAL_BGV_CALLBACK_URL="https://portal.elvixit.com/api/v1/jobs/webhooks/bgv"
# Set to "false" to suppress outbound notifications (e.g. local dev).
BGV_WEBHOOK_ENABLED="true"
